# Shared auth/runtime
AZURE_AUTH_MODE=cli
# AZURE_CLIENT_ID=<managed-identity-client-id>

# Search endpoints
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SOURCE_SEARCH_ENDPOINT=https://<source-search-service>.search.windows.net
TARGET_SEARCH_ENDPOINT=https://<target-search-service>.search.windows.net
SOURCE_INDEX=<source-index-name>
TARGET_INDEX=<new-target-index-name>

# Backup and migration directories (must be new/empty per run)
BACKUP_DIR=./backup
MIGRATION_DIR=./migration-output

# Migration field/model settings
TEXT_FIELD=content
VECTOR_FIELD=vector
MODEL_VARIANT=fast
VECTOR_DIMENSIONS=1024

# Function endpoint/auth for re-embedding
FUNCTION_BASE_ENDPOINT=https://<function-app>.azurewebsites.net
FUNCTION_AUTH_RESOURCE_ID=api://<function-entra-app-client-id>

# Optional query vectorizer identity for Search
# SEARCH_FUNCTION_IDENTITY_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/<name>
